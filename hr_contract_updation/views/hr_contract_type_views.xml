<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_type_view_list" model="ir.ui.view">
        <field name="name">hr.contract.type.view.list</field>
        <field name="model">hr.contract.type</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list string="Loại hợp đồng">
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hr_contract_type_view_form" model="ir.ui.view">
        <field name="name">hr.contract.type.view.form</field>
        <field name="model">hr.contract.type</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Loại hợp đồng">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_contract_type_action" model="ir.actions.act_window">
        <field name="name">Loại hợp đồng</field>
        <field name="res_model">hr.contract.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_contract_type_root"
              name="Loại hợp đồng"
              parent="hr.menu_hr_root"
              action="hr_contract_type_action"
              sequence="90"/>
</odoo>
