<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_contract_form_updation" model="ir.ui.view">
        <field name="name">hr.contract.view.form.updation</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">

            <!-- Hiển thị mã hợp đồng -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="contract_code" readonly="1" class="oe_inline" />
            </xpath>

            <!-- Hiển thị thông tin nhân viên -->
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="birthday"/>
                <field name="identification_id"/>
                <field name="id_issue_date"/>
                <field name="id_issue_place"/>
                <field name="private_city"/>
                <field name="job_title"/>
            </xpath>

        </field>
    </record>
</odoo>
