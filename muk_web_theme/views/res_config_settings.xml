<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="view_res_config_settings_appsbar_form" model="ir.ui.view">
	    <field name="name">form cài đặt cấu hình</field>
	    <field name="model">res.config.settings</field>
	    <field name="inherit_id" ref="muk_web_appsbar.view_res_config_settings_form"/>
	    <field name="arch" type="xml">
	    	<xpath expr="//field[@name='appbar_image']/../.." position="attributes">
	    		<attribute name="invisible">1</attribute>
	    	</xpath>
	    </field>
	</record>

	<record id="view_res_config_settings_colors_form" model="ir.ui.view">
	    <field name="name">form cài đặt màu sắc</field>
	    <field name="model">res.config.settings</field>
	    <field name="inherit_id" ref="muk_web_colors.view_res_config_settings_form"/>
	    <field name="arch" type="xml">
	    	<xpath expr="//block[@id='branding_settings']" position="attributes">
	    		<attribute name="invisible">1</attribute>
	    	</xpath>
	    	<xpath expr="//block[@id='branding_settings']" position="after">
	    		<block title="Giao diện Backend" id="theme_settings">
	    			<setting string="Màu sắc Giao diện" help="Tùy chỉnh giao diện của chủ đề">
                     	<div class="w-50 row">
                            <label for="color_brand_light" string="Thương hiệu" class="d-block w-75 py-2"/>
                            <field name="color_brand_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_primary_light" string="Chính" class="d-block w-75 py-2"/>
                            <field name="color_primary_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="theme_color_appsmenu_text" string="Văn bản Menu" class="d-block w-75 py-2"/>
                            <field name="theme_color_appsmenu_text" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="theme_color_appbar_text" string="Văn bản Ứng dụng" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_text" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="theme_color_appbar_active" string="Ứng dụng Đang Hoạt Động" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_active" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="theme_color_appbar_background" string="Nền" class="d-block w-75 py-2"/>
                            <field name="theme_color_appbar_background" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                    </setting>
	    			<setting string="Màu sắc Ngữ cảnh" help="Tùy chỉnh màu sắc ngữ cảnh của hệ thống">
                     	<div class="w-50 row">
                            <label for="color_info_light" string="Thông tin" class="d-block w-75 py-2"/>
                            <field name="color_info_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_success_light" string="Thành công" class="d-block w-75 py-2"/>
                            <field name="color_success_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_warning_light" string="Cảnh báo" class="d-block w-75 py-2"/>
                            <field name="color_warning_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>
                     	<div class="w-50 row">
                            <label for="color_danger_light" string="Nguy hiểm" class="d-block w-75 py-2"/>
                            <field name="color_danger_light" class="d-block w-25 p-0 m-0" widget="color"/>
                        </div>                        
                        <button 
                            name="action_reset_theme_color_assets" 
                            icon="oi-arrow-right" 
                            type="object" 
                            string="Đặt lại Màu sắc Giao diện" 
                            class="btn-link"
                        />
                    </setting>
	    			<setting 
	    				string="Hình nền" 
	    				company_dependent="1" 
	    				help="Đặt hình nền cho menu ứng dụng"
	    			>
	    				<field name="theme_background_image" widget="image" class="ml-4 w-75"/>
                    </setting>
                    <setting 
                    	string="Favicon &amp; Logo" 
                    	company_dependent="1" 
                    	help="Đặt favicon và logo riêng cho thanh ứng dụng"
                    >
		    			<div class="w-50 row">
	                    	<label for="appbar_image" string="Logo" class="o_light_label mb-1"/>
	                        <field name="appbar_image" widget="image" class="ml-4 oe_avatar"/>
	                        <div class="w-100 mt-1"/>
	                    	<label for="theme_favicon" string="Favicon" class="o_light_label mb-1"/>
	                        <field name="theme_favicon" widget="image" class="ml-4 oe_avatar"/>
	                    </div>
	                </setting>
	    		</block>
	    	</xpath>
	    </field>
	</record>
	
</odoo>
