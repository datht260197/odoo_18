<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Biểu mẫu (Form view) cho Mục trong danh sách kiểm tra -->
    <record id="checklist_item_view_form" model="ir.ui.view">
        <field name="name">checklist.item.view.form</field>
        <field name="model">checklist.item</field>
        <field name="arch" type="xml">
            <form string="Mục danh sách kiểm tra">
                <sheet>
                    <group>
                        <group>
                            <field name="name" string="Tên mục"/>
                            <field name="description" string="Mô tả"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
